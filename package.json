{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server.ts",
    "build": "npm run clean && vite build && npm run build-server",
    "build-server": "esbuild server.ts --bundle --platform=node --target=node24 --external:sharp --outfile=server.cjs --format=cjs",
    "repair:copy": "node scripts/rewrite-native-copy.cjs",
    "repair:copy:execute": "node scripts/rewrite-native-copy.cjs --execute",
    "migrate:mysql": "node migrate-mysql.cjs",
    "migrate:mysql:offline": "node migrate-mysql.cjs --offline",
    "migrate:mysql:execute": "node migrate-mysql.cjs --execute --i-backed-up",
    "start": "node server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "mysql2": "^3.22.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "6.30.2",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.3",
    "tailwindcss": "4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
